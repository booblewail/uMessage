# uMessage settings. `make dev` copies this file to `.env` and fills in API_TOKEN for you.
# The backend (pydantic-settings) and the frontend (next.config.ts) both read the repo-root
# `.env`; a variable set in the environment wins over the file, e.g. `UMESSAGE_MODE=demo make dev`.

# --- Backend ---------------------------------------------------------------------------

# Shared secret for every /api/* route except /api/health (and /ws later), sent as
# `Authorization: Bearer <token>`. At least 16 characters, e.g. `openssl rand -hex 32`.
API_TOKEN=

# `real` talks to Beeper Desktop; `demo` runs on fake adapters and needs no credentials.
UMESSAGE_MODE=real

# Demo mode only: whether the fake Message Source reports Beeper Desktop as running.
# Set to false to see the "Beeper Desktop isn't running" state.
DEMO_BEEPER_RUNNING=true

# SQLAlchemy async URL of the SQLite database. Default: backend/data/umessage.db.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/umessage.db

# IANA time zone used to display times and resolve relative dates ("tomorrow at 7").
USER_TIMEZONE=UTC

# Where the frontend is served; this origin may call the API (CORS).
FRONTEND_URL=http://127.0.0.1:3000
# Further allowed CORS origins, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Beeper Desktop's local API (ADR-0003). Its address is confirmed by the Phase 0 spike (#2).
BEEPER_API_URL=http://127.0.0.1:23373

# --- Frontend --------------------------------------------------------------------------

# Backend base URL the browser calls. Change it together with `make dev API_PORT=...`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Token the browser sends; defaults to API_TOKEN when unset.
# NEXT_PUBLIC_API_TOKEN=
