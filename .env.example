# uMessage settings. `make dev` copies this file to `.env` and fills in API_TOKEN for you.
# The backend (pydantic-settings) and the frontend (next.config.ts) both read the repo-root
# `.env`; a variable set in the environment wins over the file, e.g. `UMESSAGE_MODE=demo make dev`.

# --- Backend ---------------------------------------------------------------------------

# Shared secret for every /api/* route except /api/health, sent as
# `Authorization: Bearer <token>`; the /ws WebSocket takes it as `?token=<token>`.
# At least 16 characters, e.g. `openssl rand -hex 32`.
API_TOKEN=

# `real` talks to Beeper Desktop; `demo` runs on fake adapters and needs no credentials.
UMESSAGE_MODE=real

# Demo mode only: whether the fake Message Source reports Beeper Desktop as running.
# Set to false to see the "Beeper Desktop isn't running" state.
DEMO_BEEPER_RUNNING=true

# Demo mode only: about how often (seconds, give or take a third) a scripted Message arrives,
# so live updates can be seen. 0 turns the trickle off.
DEMO_NEW_MESSAGE_SECONDS=30

# How often (seconds) new Messages are fetched from Beeper Desktop.
NEW_MESSAGES_POLL_SECONDS=3

# SQLAlchemy async URL of the SQLite database. Default: backend/data/umessage.db.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/umessage.db

# IANA time zone used to display times and resolve relative dates ("tomorrow at 7"),
# e.g. Australia/Sydney. Set it to your Mac's time zone.
USER_TIMEZONE=UTC

# --- Plan detection (ADR-0005) -------------------------------------------------------

# Gemini API key, on a paid tier (chat text is private; Google doesn't train on paid-tier
# data). Without one, real mode still runs, with plan detection off. Not needed in demo mode.
GEMINI_API_KEY=
# The Gemini model that reads Chats for plans.
GEMINI_MODEL=gemini-3.5-flash

# How long (seconds) a Chat must be quiet after a new Message before it is checked for
# plans, so a plan made over several Messages is read once, as a whole.
PLAN_SETTLE_SECONDS=60
# Plans the model is less sure of than this (0-1) are not shown.
PLAN_CONFIDENCE_THRESHOLD=0.5
# At most this many plan checks are sent to Gemini at the same time.
PLAN_MAX_CONCURRENT=2

# Where the frontend is served; this origin may call the API (CORS).
FRONTEND_URL=http://127.0.0.1:3000
# Further allowed CORS origins, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Beeper Desktop's local API (ADR-0003). Its address is confirmed by the Phase 0 spike (#2).
BEEPER_API_URL=http://127.0.0.1:23373

# --- Frontend --------------------------------------------------------------------------

# Backend base URL the browser calls. Change it together with `make dev API_PORT=...`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Token the browser sends; defaults to API_TOKEN when unset.
# NEXT_PUBLIC_API_TOKEN=
